{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GatewaySettings": {
    "WebhookSecretKey": "",
    "ApiKey": "",
    "PaymentsRateLimitPermitLimit": 100,
    "PaymentsRateLimitWindowSeconds": 60,
    "IdempotencyTtlMinutes": 1440,
    "IdempotencyLockTtlSeconds": 60,
    "MaxWebhookPayloadBytes": 1048576,
    "WebhookTimestampToleranceSeconds": 300,
    "DownstreamOrderServiceUrl": "https://httpbin.org/post",
    "UseRedis": false,
    "RedisConnectionString": "localhost:6379"
  },
  "Resilience": {
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMilliseconds": 500,
    "AttemptTimeoutSeconds": 5,
    "TotalTimeoutSeconds": 15,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingSeconds": 30,
    "CircuitBreakerMinimumThroughput": 10,
    "CircuitBreakerBreakSeconds": 15
  }
}
